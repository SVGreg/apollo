# ==============================================================================
# Apollo Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your API credentials:
#   cp .env.example .env
# Models themselves are chosen in config/apollo.jsonc; this file only holds secrets
# and a few machine-local switches.

# LLM providers — configure at least one. The default config uses Google.
GOOGLE_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPEN_ROUTER_API_KEY=
XAI_API_KEY=

# Google Cloud Vision OCR (optional — enables the advanced OCR path)
OCR_API_KEY=

# Default execution profile for `apollo run` and the console (flash or pro)
APOLLO_DEFAULT_PROFILE=flash

# Target simulator UDID used when a command does not name one.
# `xcrun simctl list devices available` prints the UDIDs; leaving this empty lets
# Apollo pick the booted simulator.
# ADB_DEVICE_SERIAL=

# Screen recording backend: auto (ffmpeg over the WDA MJPEG stream when ffmpeg is
# installed, else simctl) | mjpeg | simctl
# APOLLO_IOS_RECORDING_BACKEND=auto

# Switch every model in config/apollo.jsonc to a named preset for one process, e.g.
# gemini-flagship, anthropic-sonnet, openai-gpt4o, cost-saving, local-ollama
# APOLLO_LLM_PRESET=

# Where Apollo keeps its cache (WebDriverAgent bundles, databases). Defaults to the
# OS application-support directory.
# APOLLO_APP_DIR=
